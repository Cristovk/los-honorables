{
  "name": "los-honorables",
  "version": "1.0.0",
  "description": "Proyecto para consultar y procesar datos del Senado y la Cámara de Diputados de Chile",
  "main": "dist/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "build:functions": "bun run build && cd dist/functions && bun install",
    "test": "jest",
    "lint": "eslint .",
    "deploy": "bun run build && firebase deploy",
    "type-check": "tsc --noEmit",
    "procesarEndpoint": "node scripts/procesarEndpoint.js",
    "collect": "node scripts/collector-servicios.js",
    "check-firestore": "node scripts/check-firestore.js",
    "functions": "tsx src/functions/manual/function-manager.ts",
    "emulators": "bun run build:functions && firebase emulators:start",
    "emulators:functions": "bun run build:functions && firebase emulators:start --only functions"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.83.0",
    "axios": "^1.7.9",
    "chalk": "^5.6.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^11.2.0",
    "firebase-admin": "^13.0.1",
    "firebase-functions": "^6.1.2",
    "jsdom": "^25.0.1",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/xml2js": "^0.4.14",
    "firebase-tools": "^14.22.0",
    "inquirer": "^12.10.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.16.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "senado",
    "chile",
    "cámara de diputados",
    "legislación",
    "datos abiertos",
    "firestore",
    "typescript",
    "api"
  ],
  "author": "Winnie Cofre",
  "license": "MIT"
}